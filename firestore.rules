rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isChatMember(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    match /users/{userId} {
      // The app searches user profiles by username. Only signed-in users can read them.
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,24}$')
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.bio == ''
        && request.resource.data.blocked is list;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'bio', 'blocked'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160
        && request.resource.data.blocked is list;

      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 100
        && request.resource.data.memberNames is list
        && request.resource.data.isGroup is bool;

      // Members may only update the chat preview/timestamp, not its membership or owner.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'updatedAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 4000;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);

        allow create: if isChatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.imageUrl is string
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'text', 'imageUrl', 'createdAt'
          ]);

        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.chatId is string
        && request.resource.data.reportedIds is list
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.status == 'pending';

      allow read, update, delete: if false;
    }
  }
}